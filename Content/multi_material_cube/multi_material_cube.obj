# Blender 5.2.2 LTS
# www.blender.org
mtllib multi_material_cube.mtl
o MultiMaterialCube
v -1.000000 -1.000000 1.000000
v 1.000000 -1.000000 1.000000
v 1.000000 -1.000000 -1.000000
v -1.000000 -1.000000 -1.000000
v -1.000000 1.000000 1.000000
v 1.000000 1.000000 1.000000
v 1.000000 1.000000 -1.000000
v -1.000000 1.000000 -1.000000
vn -0.0000 -1.0000 -0.0000
vn -0.0000 1.0000 -0.0000
vn -0.0000 -0.0000 1.0000
vn 1.0000 -0.0000 -0.0000
vn -0.0000 -0.0000 -1.0000
vn -1.0000 -0.0000 -0.0000
s 0
usemtl Face_Red
f 1//1 4//1 3//1 2//1
usemtl Face_Green
f 5//2 6//2 7//2 8//2
usemtl Face_Blue
f 1//3 2//3 6//3 5//3
usemtl Face_Yellow
f 2//4 3//4 7//4 6//4
usemtl Face_Cyan
f 3//5 4//5 8//5 7//5
usemtl Face_Magenta
f 4//6 1//6 5//6 8//6
